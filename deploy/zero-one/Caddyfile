{
	email {$ACME_EMAIL}
	servers {
		max_header_size 64kb
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

(sub2api_proxy) {
	reverse_proxy sub2api:8080 {
		# These overwrite untrusted forwarding headers received from clients.
		header_up Host {host}
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		header_up -X-Client-IP
		header_up -X-Cluster-Client-IP
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		transport http {
			compression off
		}
	}
}

(access_log) {
	log {
		output stdout
		format json
	}
}

api.01yapi.com {
	import access_log

	@landing {
		method GET HEAD
		path /
	}

	handle @landing {
		root * /srv/landing
		rewrite * /index.html
		encode zstd gzip
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		header Permissions-Policy "camera=(), geolocation=(), microphone=()"
		header Referrer-Policy "no-referrer"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	@landing_notice path /_landing/THIRD_PARTY_NOTICES.txt
	handle @landing_notice {
		root * /srv/landing
		rewrite * /THIRD_PARTY_NOTICES.txt
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle_path /_landing/* {
		root * /srv/landing
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle {
		header X-Robots-Tag "noindex, nofollow"
		import sub2api_proxy
	}
}

app.01yapi.com {
	import access_log

	@public_home {
		method GET HEAD
		path /
	}

	header @public_home Cache-Control "no-store"
	redir @public_home https://api.01yapi.com{uri} 307

	header X-Robots-Tag "noindex, nofollow"
	import sub2api_proxy
}

api.01yapi.cc {
	import access_log

	@backup_root {
		method GET HEAD
		path /
	}

	header @backup_root Cache-Control "no-store"
	header @backup_root Content-Type "application/json; charset=utf-8"
	respond @backup_root `{"role":"backup","primary":"https://api.01yapi.com","automatic_failover":false}` 200

	import sub2api_proxy
}

01yapi.com, www.01yapi.com {
	import access_log
	redir https://api.01yapi.com{uri} 308
}
