ARG NODE_IMAGE=node:24-alpine
ARG CADDY_IMAGE=caddy:2.8.4-alpine

FROM ${NODE_IMAGE} AS landing-builder
WORKDIR /app/landing
COPY landing/package.json landing/package-lock.json ./
RUN npm ci
COPY landing/ ./
RUN npm run build

FROM ${CADDY_IMAGE}
COPY deploy/zero-one/Caddyfile /etc/caddy/Caddyfile
COPY --from=landing-builder /app/landing/dist /srv/landing
