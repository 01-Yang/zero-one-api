# Shared routing implementation for the production and supported preview edges.

(sub2api_proxy) {
	reverse_proxy sub2api:8080 {
		# These overwrite untrusted forwarding headers received from clients.
		header_up Host {host}
		header_up -CF-Connecting-IP
		header_up -True-Client-IP
		header_up -X-Client-IP
		header_up -X-Cluster-Client-IP
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		transport http {
			compression off
		}
	}
}

(recovered_console_routes) {
	root * /srv/console

	@console_asset_files {
		method GET HEAD
		path /assets/*
		file {
			try_files {path}
		}
	}

	handle @console_asset_files {
		root * /srv/console
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	@console_assets {
		method GET HEAD
		path /assets/*
	}

	handle @console_assets {
		header Cache-Control "no-store"
		header X-Content-Type-Options "nosniff"
		respond "" 404
	}

	@console_pages {
		method GET HEAD
		path /setup /home /login /register /email-verify /auth/* /forgot-password /reset-password /key-usage /legal/* /model-plaza /dashboard /keys /batch-image /usage /redeem /affiliate /available-channels /profile /subscriptions /purchase /orders /payment/* /custom/* /admin /admin/* /monitor
	}

	handle @console_pages {
		root * /srv/console
		rewrite * /index.html
		encode zstd gzip
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Content-Security-Policy "default-src 'self'; worker-src 'self' blob:; script-src 'self' 'nonce-hJm3vqvOCSJtMiorHL9OJA==' https://challenges.cloudflare.com https://*.alicdn.com https://static.cloudflareinsights.com https://turing.captcha.qcloud.com https://turing.captcha.gtimg.com https://ca.turing.captcha.qcloud.com https://global.turing.captcha.gtimg.com https://www.tycaptcha.com https://cloudcache.tencentcs.com https://*.stripe.com https://static.airwallex.com https://checkout.airwallex.com https://static-demo.airwallex.com https://checkout-demo.airwallex.com; style-src 'self' 'unsafe-inline' https://*.captcha.gtimg.com https://fonts.googleapis.com https://*.alicdn.com https://static.airwallex.com https://checkout.airwallex.com https://static-demo.airwallex.com https://checkout-demo.airwallex.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https:; frame-src https://challenges.cloudflare.com https://turing.captcha.qcloud.com https://ca.turing.captcha.qcloud.com https://www.tycaptcha.com https://*.stripe.com https://checkout.airwallex.com https://checkout-demo.airwallex.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		header Permissions-Policy "camera=(), geolocation=(), microphone=()"
		header Referrer-Policy "strict-origin-when-cross-origin"
		header X-Content-Type-Options "nosniff"
		header X-Frame-Options "DENY"
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}
}

(landing_routes) {
	@landing {
		method GET HEAD
		path /
	}

	handle @landing {
		root * /srv/landing
		rewrite * /index.html
		encode zstd gzip
		header Cache-Control "no-cache, no-store, must-revalidate"
		header Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: https:; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		header Permissions-Policy "camera=(), geolocation=(), microphone=()"
		header Referrer-Policy "no-referrer"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	@landing_notice path /_landing/THIRD_PARTY_NOTICES.txt
	handle @landing_notice {
		root * /srv/landing
		rewrite * /THIRD_PARTY_NOTICES.txt
		header Cache-Control "no-cache"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	handle_path /_landing/* {
		root * /srv/landing
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		file_server
	}

	import recovered_console_routes

	handle {
		header X-Robots-Tag "noindex, nofollow"
		import sub2api_proxy
	}
}
