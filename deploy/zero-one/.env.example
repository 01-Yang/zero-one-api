# Copy to .env and replace every placeholder before deployment.
ACME_EMAIL=admin@01yapi.com
TZ=Asia/Shanghai

POSTGRES_USER=sub2api
POSTGRES_DB=sub2api
POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-different-long-random-password

ADMIN_EMAIL=admin@01yapi.com
ADMIN_PASSWORD=replace-before-first-start
JWT_SECRET=replace-with-at-least-64-random-hex-characters
TOTP_ENCRYPTION_KEY=replace-with-at-least-64-random-hex-characters

# Local names are suitable for a single-host build. Production CI should set
# immutable registry tags and deploy the resulting image digests.
SUB2API_IMAGE=zero-one-sub2api:local
EDGE_IMAGE=zero-one-edge:local

# These are controlled-build inputs. They are not consulted by a production
# `up --no-build`; pin them in the build environment when required.
CADDY_IMAGE=caddy:2.8.4-alpine
NODE_IMAGE=node:24-alpine

# No runtime image uses a `latest` tag. For production, replace these service
# references with approved immutable digests before running `up --no-build`.
POSTGRES_IMAGE=postgres:18-alpine
REDIS_IMAGE=redis:8-alpine

# Used only by backup-postgres.sh, not loaded by a running service. Set these
# in the host scheduler environment rather than committing a real recipient.
# BACKUP_DIR=/mnt/offsite/zero-one
# BACKUP_AGE_RECIPIENT=age1replace-with-your-backup-public-recipient
# BACKUP_SENTINEL_FILE=.offsite-mounted
